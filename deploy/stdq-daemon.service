# stdq 常驻进程的 systemd 单元模板
#
# 用前改 3 处（标了 <...>）：
#   User / Environment=STDQ_DATA_DIR / ExecStart 的 python 路径
# 然后：
#   sudo cp deploy/stdq-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stdq-daemon
#   systemctl status stdq-daemon        # 看状态
#   journalctl -u stdq-daemon -f        # 看日志
#
# 就绪判定：等 <STDQ_DATA_DIR>/stdq_daemon.ready 出现，或 `stdq daemon status` 显示"可连接"。
# 首次启动要加载语义模型（分钟级，看机器），之后查询就是亚秒级。

[Unit]
Description=stdq resident search daemon (keeps the embedding model in memory)
After=network.target

[Service]
Type=simple
User=<你的用户名>
Environment=STDQ_DATA_DIR=<你的数据目录，例如 /home/you/.stdq>
ExecStart=<python 解释器绝对路径> -m stdq daemon start
Restart=on-failure
RestartSec=5
# 语义模型常驻内存约 1-2 GB，按机器情况设上限
# MemoryMax=4G

[Install]
WantedBy=multi-user.target
